<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> — SpendWise</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

<%- include('../partials/navbar') %>

<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <%- include('../partials/flash') %>

    <div class="page-header">
      <div>
        <h1 class="page-title">Expenses</h1>
        <p class="page-subtitle"><%= totalCount %> records · ₹<%= totalAmount.toLocaleString('en-IN', {maximumFractionDigits:0}) %> total</p>
      </div>
      <a href="/expenses/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Expense</a>
    </div>

    <!-- Filter Bar -->
    <div class="card-panel mb-3">
      <form method="GET" action="/expenses" class="row g-2 align-items-end">
        <div class="col-sm-4 col-md-3">
          <label class="form-label small">Category</label>
          <select name="category" class="form-select form-select-sm">
            <option value="">All categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-sm-4 col-md-3">
          <label class="form-label small">From</label>
          <input type="date" name="from" class="form-control form-control-sm" value="<%= query.from || '' %>"/>
        </div>
        <div class="col-sm-4 col-md-3">
          <label class="form-label small">To</label>
          <input type="date" name="to" class="form-control form-control-sm" value="<%= query.to || '' %>"/>
        </div>
        <div class="col-sm-12 col-md-3 d-flex gap-2">
          <button type="submit" class="btn btn-sm btn-primary flex-fill">Filter</button>
          <a href="/expenses" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
      </form>
    </div>

    <!-- Table -->
    <div class="card-panel p-0">
      <% if (expenses.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-inbox fs-1 d-block mb-2"></i>
          No expenses found. <a href="/expenses/new">Add one?</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover expense-table mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Category</th>
                <th>Payment</th>
                <th class="text-end">Amount</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% expenses.forEach(e => { %>
                <tr>
                  <td class="text-muted small"><%= new Date(e.date).toLocaleDateString('en-IN') %></td>
                  <td><%= e.description || '—' %></td>
                  <td><span class="cat-badge"><%= e.category %></span></td>
                  <td class="text-muted small"><%= e.paymentMethod %></td>
                  <td class="text-end fw-500">₹<%= e.amount.toLocaleString('en-IN') %></td>
                  <td class="text-center">
                    <a href="/expenses/<%= e._id %>/edit" class="btn btn-xs btn-outline-secondary me-1">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/expenses/<%= e._id %>?_method=DELETE" method="POST" class="d-inline"
                      onsubmit="return confirm('Delete this expense?')">
                      <button class="btn btn-xs btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="d-flex justify-content-center py-3 gap-2">
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a href="?<%= new URLSearchParams({...query, page: i}).toString() %>"
                class="btn btn-sm <%= currentPage === i ? 'btn-primary' : 'btn-outline-secondary' %>"><%= i %></a>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>

  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
